---
import Attribution from '../components/Attribution.astro';
import Closer from '../components/Closer.astro';
import ComingSoon from '../components/ComingSoon.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Nav from '../components/Nav.astro';
import Pains from '../components/Pains.astro';
import Roadmap from '../components/Roadmap.astro';
import UseCases from '../components/UseCases.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<Nav />
	<main id="contenido">
		<!-- Orden fijado por el dueño (2026-09-10). Ninguna sección retiene el
		     scroll: la página se lee de arriba a abajo a la velocidad del dedo.
		     Las preguntas van DESPUÉS del CTA a propósito — quien ya está
		     convencido no tiene que pasar por encima de ellas. -->
		<Hero />
		<Pains />
		<UseCases />
		<Attribution />
		<Roadmap />
		<ComingSoon />
		<Closer />
		<Faq />
	</main>
	<Footer />
</Layout>

---
import Attribution from '../components/Attribution.astro';
import Closer from '../components/Closer.astro';
import Faq from '../components/Faq.astro';
import HeroScene from '../components/HeroScene.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Modularity from '../components/Modularity.astro';
import Nav from '../components/Nav.astro';
import Pains from '../components/Pains.astro';
import Whitelabel from '../components/Whitelabel.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<Nav />
	<main id="contenido">
		<!-- Grounds alternate the way the reference template does: ground → night
		     → ground → paper → ground → paper → ground → mist → night. The first
		     two beats belong to one component — the scene cross-fades ground into
		     night as the hero's shot locks into the module stage. -->
		<HeroScene />
		<Pains />
		<Whitelabel />
		<Attribution />
		<Modularity />
		<HowItWorks />
		<Faq />
		<Closer />
	</main>
</Layout>

<script>
	// Starts the ambient brand rotation for the page (§3.2).
	import '../scripts/brand';
</script>

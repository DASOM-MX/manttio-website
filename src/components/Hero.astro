---
import { Icon } from 'astro-icon/components';
import { MODULES } from '../data/modules';
import FauxFrame from './FauxFrame.astro';

const hero = MODULES[0];
---

<section class="relative overflow-hidden pt-28 pb-16 sm:pt-36 sm:pb-24">
	<!-- brand glows: the only decoration, and they follow the rotation -->
	<div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
		<span class="tint absolute -top-40 -left-24 size-[34rem] rounded-full bg-brand-400 opacity-[0.18] blur-[90px]"></span>
		<span class="tint absolute top-10 -right-20 size-[26rem] rounded-full bg-brand-300 opacity-[0.16] blur-[90px]"></span>
	</div>

	<div class="shell grid gap-14 lg:grid-cols-[1.05fr_1fr] lg:items-center lg:gap-10">
		<div>
			<h1 class="measure-head text-display font-semibold tracking-[-0.03em]" data-reveal>
				Tu negocio en un solo lugar.
			</h1>

			<p class="measure-lead mt-6 text-lead text-ink-muted" data-reveal>
				Hoy tu operación vive en WhatsApp, Excel y la cabeza de tu jefe de cuadrilla. Manttio la junta:
				clientes, cotizaciones, visitas, reportes firmados y material. Con la marca de tu empresa, no con
				la nuestra.
			</p>

			<div class="mt-9 flex flex-col gap-3 sm:flex-row" data-reveal>
				<a
					href="#contacto"
					class="tint inline-flex items-center justify-center gap-2 rounded-full bg-brand-ink px-7 py-3.5 font-medium text-paper shadow-[0_10px_28px_color-mix(in_oklab,var(--b-500)_32%,transparent)]"
					data-magnetic
				>
					Solicitar demo
					<Icon name="lucide:arrow-right" class="size-4" />
				</a>
				<a
					href="#modulos"
					class="inline-flex items-center justify-center rounded-full bg-paper px-7 py-3.5 font-medium shadow-e1 transition-transform hover:-translate-y-px"
				>
					Ver los módulos
				</a>
			</div>

		</div>

		<!-- the set-piece: cards assembling on load -->
		<div class="relative" data-hero-stage>
			<FauxFrame module={hero} class="relative z-10" />

			<div
				class="absolute -bottom-12 -left-4 z-20 hidden w-60 rounded-frame bg-paper p-4 shadow-e3 sm:block"
				data-hero-card
			>
				<div class="flex items-center gap-2.5">
					<span class="tint grid size-9 place-items-center rounded-xl bg-brand-50 text-brand-ink">
						<Icon name="lucide:pen-line" class="size-4" />
					</span>
					<div class="min-w-0">
						<p class="truncate font-medium">Firma capturada</p>
						<p class="text-caption text-ink-faint">Hotel Vista Real</p>
					</div>
				</div>
			</div>

			<div
				class="absolute -top-6 -right-3 z-20 hidden rounded-frame bg-paper px-4 py-3 shadow-e3 md:block"
				data-hero-card
			>
				<p class="label">Sin señal</p>
				<p class="nums mt-0.5 font-medium">3 capturas en cola</p>
			</div>
		</div>
	</div>
</section>

<script>
	import { magnetic, prefersReduced, reveal } from '../scripts/motion';
	import { animate, stagger } from 'motion';

	reveal('[data-reveal]');


	document.querySelectorAll<HTMLElement>('[data-magnetic]').forEach((el) => magnetic(el));

	// Hero composite assembles once on load.
	const stage = document.querySelector('[data-hero-stage]');
	if (stage && !prefersReduced()) {
		const parts = stage.querySelectorAll(':scope > *');
		animate(
			parts,
			{ opacity: [0, 1], transform: ['translateY(26px) scale(0.985)', 'translateY(0px) scale(1)'] },
			{ duration: 0.65, delay: stagger(0.09), ease: [0.2, 0.7, 0.3, 1] },
		);
	}
</script>

---
/**
 * Hero + module showcase as one continuous scroll scene.
 *
 * The product frame starts small in the hero's top-right, scales up as you
 * scroll, and locks as the exact frame the module rail then drives — so the
 * hero doesn't hand off to the showcase, it *becomes* it.
 *
 * On a phone there is no grow phase: the hero stays in normal flow and the
 * modules get their own sticky scene below it — locked to the viewport,
 * full-bleed, one panel per screenful of scroll.
 */
import { Icon } from 'astro-icon/components';
import { MODULES } from '../data/modules';
import AppShot from './AppShot.astro';

const steps = MODULES.length;

/**
 * The h1 rotates its subject: "<subject> en un solo lugar."
 *
 * The first entry is the one the h1 actually reads as: it is the sr-only copy
 * that gives the heading its accessible name, and the only subject a
 * reduced-motion visitor ever sees. The rest are decorative, so the stack is
 * aria-hidden and there is no live region — a loop that announces itself every
 * few seconds is noise, not information.
 */
const SUBJECTS = [
	'Tu negocio',
	'Tus reportes',
	'Tus clientes',
	'Tus órdenes',
	'Tu calendario',
	'Tus facturas',
	'Tus contratos',
	'Tu sitio',
];

/** Scroll budget, in vh, for each phase after the initial viewport. */
const GROW = 60;
const STEP = 38;
/** Mobile has no grow phase, just one locked viewport per module. */
const MSTEP = 42;

---

<section
	id="inicio"
	class="scene"
	style={`--steps:${steps}; --grow:${GROW}; --step:${STEP}; --mstep:${MSTEP}`}
	data-scene
	data-scene-grow={GROW}
	data-scene-step={STEP}
>
	<div class="stage">
		<!-- brand glows, same as before -->
		<div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
			<span class="tint absolute -top-40 -left-24 size-[34rem] rounded-full bg-brand-400 opacity-[0.18] blur-[90px]"></span>
			<span class="tint absolute top-10 -right-20 size-[26rem] rounded-full bg-brand-300 opacity-[0.16] blur-[90px]"></span>
		</div>

		<!-- ---------- hero copy ---------- -->
		<div class="hero shell" data-hero>
			<h1 class="text-hero font-semibold tracking-[-0.04em]" data-rot-title>
				<span class="rot" aria-hidden="true">
					{
						SUBJECTS.map((subject, i) => (
							<span class="rot-item" data-rot-item data-active={i === 0 ? true : undefined}>
								{subject}
							</span>
						))
					}
				</span>
				<span class="sr-only">{SUBJECTS[0]}</span>
				<span class="rot-tail">en un solo lugar.</span>
			</h1>

			<!-- description + CTAs, left, directly under the title -->
			<div class="hero-copy">
				<p class="text-lead text-ink-muted">
					Hoy tu información vive repartida entre WhatsApp, Excel y la memoria de tu equipo.
					Manttio la reúne y la deja en orden: clientes, cotizaciones, visitas, reportes firmados y
					material. Todo con la marca de tu empresa, nunca con la nuestra.
				</p>
				<div class="mt-8 flex flex-col gap-3 sm:flex-row">
					<a
						href="#contacto"
						class="tint inline-flex items-center justify-center gap-2 rounded-full bg-brand-ink px-7 py-3.5 font-medium text-paper shadow-[0_10px_28px_color-mix(in_oklab,var(--b-500)_32%,transparent)]"
						data-magnetic
					>
						Solicitar demo
						<Icon name="lucide:arrow-right" class="size-4" />
					</a>
					<a
						href="#modulos"
						class="inline-flex items-center justify-center rounded-full bg-paper px-7 py-3.5 font-medium shadow-e1 transition-transform hover:-translate-y-px"
					>
						Ver los módulos
					</a>
				</div>
			</div>
		</div>

		<!-- ---------- modules: rail + frame ----------
		     Desktop: the wrappers are display:contents, so both children keep
		     positioning against the sticky stage. Mobile: the wrappers ARE the
		     scene — .mod carries the scroll budget, .mod-stage locks to the
		     viewport while the panels cross-fade. -->
		<div class="mod" data-mod>
			<div class="mod-stage">
				<!-- ---------- module rail (fades in once the frame locks) ---------- -->
				<div class="rail-wrap shell" data-rail-wrap>
					<div class="rail-inner">
						<div class="mb-7">
							<p class="label">Los módulos</p>
							<h2 id="modulos" class="mt-3 text-h2 font-semibold tracking-[-0.025em]">
								Once piezas. Enciendes las que usas.
							</h2>
						</div>

						<!-- Mobile: the chips are gone, this names what is on screen. -->
						<p class="now" aria-hidden="true">
							{
								MODULES.map((m, i) => (
									<span class="now-item" data-now-item data-active={i === 0 ? true : undefined}>
										<Icon name={m.icon} class="size-[18px] shrink-0" />
										<span class="now-name">{m.name}</span>
										<span class="now-i">
											{String(i + 1).padStart(2, '0')}/{String(steps).padStart(2, '0')}
										</span>
									</span>
								))
							}
						</p>

						<div class="rail" role="tablist" aria-label="Módulos de Manttio">
							{
								MODULES.map((m, i) => (
									<button
										type="button"
										role="tab"
										id={`tab-${m.id}`}
										aria-controls={`panel-${m.id}`}
										aria-selected={i === 0 ? 'true' : 'false'}
										tabindex={i === 0 ? 0 : -1}
										class="rail-item"
										data-rail-item
									>
										<Icon name={m.icon} class="size-[17px] shrink-0" />
										<span class="whitespace-nowrap">{m.name}</span>
										{!m.shipped && <span class="soon">Próximamente</span>}
									</button>
								))
							}
						</div>
					</div>
				</div>

				<!-- ---------- the frame: small in the hero, locked as the stage ---------- -->
				<div class="frame-slot shell" aria-hidden="false">
					<div class="frame" data-frame>
						{
							MODULES.map((m, i) => (
								<div
									class="panel"
									id={`panel-${m.id}`}
									role="tabpanel"
									aria-labelledby={`tab-${m.id}`}
									data-panel
									data-active={i === 0 ? true : undefined}
									aria-hidden={i === 0 ? 'false' : 'true'}
								>
									<AppShot module={m} loading={i === 0 ? 'eager' : 'lazy'} />
								</div>
							))
						}
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	/* ------------------------------------------------------------------
	   Shared
	   ------------------------------------------------------------------ */
	.hero {
		display: flex;
		min-height: 100svh;
		flex-direction: column;
		justify-content: flex-start;
		gap: 2.75rem;
		padding-block: 7.5rem 3rem;
	}
	.hero-copy {
		max-width: 46ch;
	}

	/* Subject and tail are separate lines, so a longer word never shoves "en un
	   solo lugar." sideways. Grid stacking drops every subject into the same
	   cell, which reserves the tallest one up front — that is what keeps the
	   line below from jumping when a word wraps on a narrow phone. Aligning to
	   the end sends the reserve upward, into the space under the nav, instead of
	   opening a gap above the tail. */
	.rot {
		display: grid;
		grid-template-areas: 'subject';
		align-items: end;
	}
	.rot-tail {
		display: block;
	}
	.rot-item {
		grid-area: subject;
		justify-self: start;
		opacity: 0;
		transform: translateY(0.22em);
		transition:
			opacity 180ms linear,
			transform 180ms var(--ease-out);
	}
	/* The incoming word rises over ~half a second; the outgoing one leaves
	   upward in the 180 ms above, so the two never read as one movement. */
	.rot-item[data-active] {
		opacity: 1;
		transform: none;
		transition-duration: 520ms;
	}
	.rot-item[data-out] {
		transform: translateY(-0.26em);
	}

	.rail {
		display: flex;
		gap: 0.5rem;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		padding-bottom: 0.5rem;
		scrollbar-width: none;
	}
	.rail::-webkit-scrollbar {
		display: none;
	}
	.rail-item {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		flex: 0 0 auto;
		scroll-snap-align: start;
		border-radius: 999px;
		padding: 0.6rem 1rem;
		color: var(--color-ink-muted);
		background: var(--color-paper);
		box-shadow: var(--shadow-ring);
		cursor: pointer;
		transition:
			color 200ms ease,
			box-shadow 200ms ease;
	}
	.rail-item[aria-selected='true'] {
		color: var(--color-ink);
		box-shadow: var(--shadow-e1);
	}
	.rail-item .soon {
		font-size: 0.6875rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-ink-faint);
		background: var(--color-mist);
		border-radius: 999px;
		padding: 0.05rem 0.45rem;
	}

	.panel {
		opacity: 0;
		transition: opacity 320ms ease;
	}
	.panel[data-active] {
		opacity: 1;
	}

	/* ------------------------------------------------------------------
	   Mobile: hero in flow, then the modules lock to the viewport and the
	   panels switch on scroll. Full-bleed, 2px off the edge.
	   ------------------------------------------------------------------ */
	@media (max-width: 1023.98px) {
		.mod {
			position: relative;
			height: calc((100 + var(--steps) * var(--mstep)) * 1svh);
		}
		.mod-stage {
			position: sticky;
			top: 0;
			display: flex;
			height: 100svh;
			flex-direction: column;
			overflow: hidden;
			padding-block: 5.5rem 1.25rem;
		}

		.rail-wrap {
			flex: 0 0 auto;
			width: 100%;
			margin-inline: 0;
			padding-inline: 1.25rem;
		}
		/* The chips are what the scroll replaced. */
		.rail {
			display: none;
		}

		.now {
			display: grid;
			margin-top: 1.5rem;
		}
		.now-item {
			grid-area: 1 / 1;
			display: flex;
			align-items: center;
			gap: 0.6rem;
			font-weight: 600;
			opacity: 0;
			transition: opacity 260ms ease;
		}
		.now-item[data-active] {
			opacity: 1;
		}
		.now-name {
			min-width: 0;
		}
		.now-i {
			margin-left: auto;
			padding-left: 0.75rem;
			font-size: var(--text-caption);
			font-weight: 400;
			font-variant-numeric: tabular-nums;
			color: var(--color-ink-faint);
		}

		.frame-slot {
			display: grid;
			/* Both tracks capped, or the widest panel's min-content widens the
			   column and every shot bleeds past the 2px. */
			grid-template: minmax(0, 1fr) / minmax(0, 1fr);
			flex: 1;
			min-height: 0;
			width: 100%;
			margin-inline: 0;
			padding: 0;
		}
		.frame {
			display: grid;
			grid-template: minmax(0, 1fr) / minmax(0, 1fr);
			min-height: 0;
		}
		.panel {
			grid-area: 1 / 1;
			display: flex;
			min-height: 0;
			align-items: center;
			justify-content: center;
			padding: 2px;
		}
		/* Fit the shot to whatever height is left, ratio intact. The wrapper
		   around a phone-shaped shot needs a definite height of its own or the
		   image's max-height has nothing to resolve against. */
		.panel > :global(*) {
			max-height: 100%;
		}
		.panel > :global(div) {
			display: flex;
			height: 100%;
			align-items: center;
			justify-content: center;
		}
		.panel :global(img) {
			width: auto;
			height: auto;
			max-width: 100%;
			max-height: 100%;
		}
	}

	/* ------------------------------------------------------------------
	   Desktop: one sticky stage, scroll-driven.
	   ------------------------------------------------------------------ */
	@media (min-width: 1024px) {
		/* The mobile scene shell disappears so the rail and frame keep
		   positioning against the sticky stage. */
		.mod,
		.mod-stage {
			display: contents;
		}
		.now {
			display: none;
		}

		.scene {
			height: calc(100vh + (var(--grow) + var(--steps) * var(--step)) * 1vh);
		}
		.stage {
			position: sticky;
			top: 0;
			height: 100vh;
			overflow: hidden;
		}

		.hero {
			position: absolute;
			inset: 0;
			min-height: 0;
			padding-block: 9rem 2rem; /* 32px off the bottom */
			will-change: opacity, transform;
		}
		/* Image takes the left of the space under the title, copy the right. */
		.hero-copy {
			align-self: flex-end;
			margin-top: auto; /* push to the bottom of the hero */
		}

		.rail-wrap {
			position: absolute;
			inset-block: 0;
			left: 50%;
			translate: -50% 0;
			display: flex;
			align-items: center;
			padding-block: 0;
			opacity: 0;
			pointer-events: none;
			will-change: opacity;
		}
		.rail-inner {
			width: min(300px, 26%);
		}
		.rail {
			flex-direction: column;
			gap: 2px;
			overflow: visible;
			padding-bottom: 0;
		}
		.rail-item {
			position: relative;
			border-radius: 12px;
			background: transparent;
			box-shadow: none;
			padding: 0.65rem 0.85rem;
		}
		.rail-item:hover {
			color: var(--color-ink);
			background: var(--color-paper);
		}
		.rail-item[aria-selected='true'] {
			background: var(--color-paper);
			box-shadow: var(--shadow-e1);
		}
		.rail-item[aria-selected='true']::before {
			content: '';
			position: absolute;
			left: -0.55rem;
			top: 25%;
			bottom: 25%;
			width: 3px;
			border-radius: 3px;
			background: var(--color-brand-500);
			transition: background-color 1200ms ease;
		}
		.rail-item .soon {
			margin-left: auto;
		}

		/* The frame's LOCKED position. Script measures this, then transforms the
		   frame back to a small box in the hero's top-right for progress 0. */
		.frame-slot {
			position: absolute;
			inset-block: 0;
			left: 50%;
			translate: -50% 0;
			display: flex;
			align-items: center;
			justify-content: flex-end;
			padding-bottom: 0;
			pointer-events: none;
		}
		.frame {
			display: grid;
			width: 58%;
			overflow: visible;
			transform-origin: center center;
			will-change: transform;
			pointer-events: auto;
		}
		.panel {
			grid-area: 1 / 1;
			pointer-events: none;
		}
		.panel[data-active] {
			pointer-events: auto;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.panel,
		.now-item {
			transition: none;
		}
	}
</style>

<script>
	import { magnetic, prefersReduced } from '../scripts/motion';

	const scene = document.querySelector<HTMLElement>('[data-scene]');
	const stage = scene?.querySelector<HTMLElement>('.stage');
	const hero = scene?.querySelector<HTMLElement>('[data-hero]');
	const railWrap = scene?.querySelector<HTMLElement>('[data-rail-wrap]');
	const frame = scene?.querySelector<HTMLElement>('[data-frame]');
	const mod = scene?.querySelector<HTMLElement>('[data-mod]');
	const title = scene?.querySelector<HTMLElement>('h1');
	const items = Array.from(scene?.querySelectorAll<HTMLElement>('[data-rail-item]') ?? []);
	const nowItems = Array.from(scene?.querySelectorAll<HTMLElement>('[data-now-item]') ?? []);
	const panels = Array.from(scene?.querySelectorAll<HTMLElement>('[data-panel]') ?? []);
	const count = panels.length;
	const desktop = window.matchMedia('(min-width: 1024px)');

	document.querySelectorAll<HTMLElement>('[data-magnetic]').forEach((el) => magnetic(el));

	/* ---------- the h1's rotating subject ----------
	   Runs only while the hero is on screen and the tab is visible, and not at
	   all under reduced motion — there the first subject just stays put. */
	const rotTitle = scene?.querySelector<HTMLElement>('[data-rot-title]');
	const rotItems = Array.from(rotTitle?.querySelectorAll<HTMLElement>('[data-rot-item]') ?? []);

	if (rotTitle && rotItems.length > 1 && !prefersReduced()) {
		const HOLD = 2800;
		let at = 0;
		let timer: number | null = null;
		let onScreen = true;

		const advance = () => {
			const prev = rotItems[at];
			at = (at + 1) % rotItems.length;
			const next = rotItems[at];
			prev.removeAttribute('data-active');
			prev.setAttribute('data-out', '');
			next.removeAttribute('data-out');
			next.setAttribute('data-active', '');
			// Park the outgoing word back at its start once it is invisible, so
			// its next entrance rises rather than drops.
			window.setTimeout(() => prev.removeAttribute('data-out'), 200);
		};

		const sync = () => {
			if (timer !== null) {
				window.clearInterval(timer);
				timer = null;
			}
			if (onScreen && !document.hidden) timer = window.setInterval(advance, HOLD);
		};

		document.addEventListener('visibilitychange', sync);
		new IntersectionObserver(
			(entries) => {
				onScreen = entries[0].isIntersecting;
				sync();
			},
			{ threshold: 0 },
		).observe(rotTitle);
		sync();
	}

	let current = -1;
	function select(i: number, focusRail = false) {
		const next = Math.max(0, Math.min(count - 1, i));
		if (next === current) return;
		current = next;
		items.forEach((el, idx) => {
			const on = idx === next;
			el.setAttribute('aria-selected', String(on));
			el.tabIndex = on ? 0 : -1;
			if (on && focusRail) el.focus();
		});
		nowItems.forEach((el, idx) => el.toggleAttribute('data-active', idx === next));
		panels.forEach((el, idx) => {
			const on = idx === next;
			el.toggleAttribute('data-active', on);
			el.setAttribute('aria-hidden', String(!on));
		});
	}
	select(0);

	/* ---------------- the grow-and-lock transform ---------------- */
	const clamp01 = (n: number) => Math.min(1, Math.max(0, n));
	const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

	/** Geometry from the frame's LOCKED layout back to its small hero state. */
	let geo = { scale: 0.34, dx: 0, dy: 0, growEnd: 0.13 };

	function measure() {
		if (!scene || !frame || !stage) return;
		const grow = Number(scene.dataset.sceneGrow ?? 60);
		const step = Number(scene.dataset.sceneStep ?? 38);
		geo.growEnd = grow / (grow + count * step);

		// Measure both boxes untransformed, or a mid-scroll resize reads shifted
		// positions and the frame jumps.
		frame.style.transform = 'none';
		const heroTransform = hero?.style.transform ?? '';
		if (hero) hero.style.transform = 'none';
		const locked = frame.getBoundingClientRect();
		const stageBox = stage.getBoundingClientRect();
		const titleBox = title?.getBoundingClientRect();
		if (hero) hero.style.transform = heroTransform;
		if (!locked.width) return;

		// Small state: 1024px wide, left of the shell, sitting under the title.
		// Two caps keep it inside the stage on smaller screens — one on width,
		// one derived from the height actually left below the title.
		const aspect = locked.width / locked.height;
		const gapUnderTitle = 64;
		const top = (titleBox?.bottom ?? stageBox.top + stageBox.height * 0.3) + gapUnderTitle;
		const availH = stageBox.bottom - top - 32;
		const smallW = Math.min(1024, stageBox.width * 0.66, availH * aspect);
		const scale = smallW / locked.width;
		const smallH = locked.height * scale;
		const shellLeft = stageBox.left + stageBox.width * 0.1;
		const smallCx = shellLeft + smallW / 2;
		const smallCy = top + smallH / 2;

		geo.scale = scale;
		geo.dx = smallCx - (locked.left + locked.width / 2);
		geo.dy = smallCy - (locked.top + locked.height / 2);
	}

	function apply(p: number) {
		if (!frame || !hero || !railWrap) return;
		const g = clamp01(p / geo.growEnd);

		frame.style.transform =
			`translate(${lerp(geo.dx, 0, g)}px, ${lerp(geo.dy, 0, g)}px) scale(${lerp(geo.scale, 1, g)})`;

		// hero copy clears out first, rail arrives as the frame settles
		const heroOut = clamp01(g / 0.7);
		hero.style.opacity = String(1 - heroOut);
		hero.style.transform = `translateY(${-heroOut * 40}px)`;
		hero.style.pointerEvents = heroOut > 0.5 ? 'none' : '';

		railWrap.style.opacity = String(clamp01((g - 0.55) / 0.45));
		railWrap.style.pointerEvents = g > 0.9 ? 'auto' : 'none';

		if (p > geo.growEnd) {
			select(Math.floor(((p - geo.growEnd) / (1 - geo.growEnd)) * count * 0.999));
		} else {
			select(0);
		}
	}

	function reset() {
		if (!frame || !hero || !railWrap) return;
		frame.style.transform = '';
		hero.style.opacity = '';
		hero.style.transform = '';
		hero.style.pointerEvents = '';
		railWrap.style.opacity = '';
		railWrap.style.pointerEvents = '';
	}

	/** Progress through the mobile modules scene, 0…1. */
	function modProgress() {
		if (!mod) return 0;
		const travel = mod.offsetHeight - window.innerHeight;
		if (travel <= 0) return 0;
		return clamp01(-mod.getBoundingClientRect().top / travel);
	}

	let ticking = false;
	function onScroll() {
		if (ticking || !scene) return;
		ticking = true;
		requestAnimationFrame(() => {
			ticking = false;
			if (desktop.matches) {
				if (prefersReduced()) return;
				const travel = scene.offsetHeight - window.innerHeight;
				if (travel <= 0) return;
				apply(clamp01((window.scrollY - scene.offsetTop) / travel));
			} else {
				// No grow phase here — scroll only picks the panel. The lock is
				// pure sticky, so it stands with reduced motion too.
				select(Math.floor(modProgress() * count * 0.999));
			}
		});
	}

	function start() {
		if (desktop.matches && !prefersReduced()) measure();
		else reset();
		onScroll();
	}

	start();
	window.addEventListener('scroll', onScroll, { passive: true });
	desktop.addEventListener('change', start);
	window.addEventListener('resize', () => {
		if (desktop.matches && !prefersReduced()) measure();
		onScroll();
	});

	/* Rail interaction: click scrolls the scene to that module's slice. */
	items.forEach((el, i) => {
		el.addEventListener('click', () => {
			if (scene && desktop.matches && !prefersReduced()) {
				const travel = scene.offsetHeight - window.innerHeight;
				const p = geo.growEnd + ((i + 0.5) / count) * (1 - geo.growEnd);
				window.scrollTo({ top: scene.offsetTop + travel * p, behavior: 'smooth' });
			} else if (mod) {
				const travel = mod.offsetHeight - window.innerHeight;
				const top = mod.getBoundingClientRect().top + window.scrollY;
				window.scrollTo({ top: top + travel * ((i + 0.5) / count), behavior: 'smooth' });
			}
		});
		el.addEventListener('keydown', (e) => {
			let next: number | null = null;
			if (e.key === 'ArrowDown' || e.key === 'ArrowRight') next = (i + 1) % count;
			if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') next = (i - 1 + count) % count;
			if (next !== null) {
				e.preventDefault();
				select(next, true);
			}
		});
	});

	/* "Ver los módulos" / nav "Módulos" should land where the modules lock, not
	   on the h2 — that heading lives inside a sticky container, so the browser's
	   own anchor jump lands somewhere arbitrary. */
	document.querySelectorAll<HTMLAnchorElement>('a[href="#modulos"]').forEach((a) => {
		a.addEventListener('click', (e) => {
			if (!scene) return;
			const behavior = prefersReduced() ? 'auto' : 'smooth';
			if (desktop.matches) {
				e.preventDefault();
				const travel = scene.offsetHeight - window.innerHeight;
				window.scrollTo({ top: scene.offsetTop + travel * geo.growEnd + 2, behavior });
			} else if (mod) {
				e.preventDefault();
				window.scrollTo({ top: mod.getBoundingClientRect().top + window.scrollY + 2, behavior });
			}
		});
	});

</script>

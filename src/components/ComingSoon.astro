---
import { Icon } from "astro-icon/components";
import { MODULES } from "../data/modules";
import FauxFrame from "./FauxFrame.astro";

/**
 * Lo que viene — los módulos que todavía NO están en producción.
 *
 * Se deriva de `shipped: false` en `../data/modules.ts`, nunca de una lista
 * escrita a mano: así esta sección y /features no se pueden contradecir, y el
 * día que un módulo se libere desaparece de aquí solo.
 *
 * Sin fechas. No hay un compromiso de trimestre que el producto pueda cumplir
 * hoy, y una fecha inventada en una página de ventas es una deuda, no un
 * argumento.
 */
const soon = MODULES.filter((m) => !m.shipped);
---

{
  soon.length > 0 && (
    <section id="lo-que-viene" class="soon">
      <div class="shell">
        <p class="label">Lo que viene</p>
        <h2 class="section-title measure-head mt-3" data-reveal-s>
          En construcción, y lo decimos.
        </h2>
        <p class="measure mt-5 text-lead text-ink-muted">
          Estos módulos todavía no están disponibles. Aparecen aquí porque
          forman parte del plan y porque prefieres saberlo antes de contratar,
          no después.
        </p>

        <div class="soon-grid">
          {soon.map((m) => (
            <article class="soon-card" data-soon>
              <div class="soon-copy">
                <p class="soon-head">
                  <Icon name={m.icon} class="size-5 shrink-0" />
                  <span class="soon-name">{m.name}</span>
                  <span class="soon-chip">Próximamente</span>
                </p>
                <p class="measure mt-3 text-ink-muted">{m.claim}</p>
              </div>
              <FauxFrame module={m} />
            </article>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>@import './ComingSoon.css';</style>

<script>
  import { reveal, revealStagger } from "../scripts/motion";
  reveal("[data-reveal-s]");
  revealStagger("[data-soon]");
</script>

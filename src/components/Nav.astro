---
import { SITE_TITLE } from '../consts';

const links = [
	{ href: '/features', label: 'Módulos' },
	{ href: '/#casos', label: 'Casos de uso' },
	{ href: '/#lo-que-viene', label: 'Lo que viene' },
	{ href: '/#preguntas', label: 'Preguntas' },
];
---

<header id="nav" class="nav" data-nav>
	<nav class="shell nav-bar" aria-label="Principal">
		<a href="/" class="wordmark">
			<!-- Decorative: the wordmark beside it already names the site, so an alt
			     here would make a screen reader announce "Manttio" twice for one
			     link. The intrinsic width/height reserve the box before the PNG
			     lands — the mark is 553×451, not the square the filename suggests. -->
			<img
				src="/manttio-logo-1-1-no-bg.png"
				alt=""
				width="553"
				height="451"
				class="h-7 w-auto"
			/>
			<span class="text-lead">{SITE_TITLE}</span>
		</a>

		<div class="nav-links">
			{links.map((l) => <a href={l.href} class="nav-link">{l.label}</a>)}
			<a href="/#contacto" class="nav-cta">Solicitar demo</a>
		</div>

		<button
			type="button"
			class="burger-btn"
			aria-expanded="false"
			aria-controls="menu-movil"
			aria-label="Abrir menú"
			data-menu-btn
		>
			<!-- three bars that fold into an X; the button's aria-label carries the
			     meaning, so the shape itself is decorative -->
			<span class="burger" aria-hidden="true">
				<span class="bar bar-1"></span>
				<span class="bar bar-2"></span>
				<span class="bar bar-3"></span>
			</span>
		</button>
	</nav>

	<div id="menu-movil" class="menu" data-menu>
		<div class="menu-clip">
			<div class="shell menu-inner">
				{
					links.map((l, i) => (
						<a href={l.href} class="menu-link" style={`--i:${i}`} data-menu-link>
							{l.label}
						</a>
					))
				}
				<a
					href="/#contacto"
					class="menu-cta"
					style={`--i:${links.length}`}
					data-menu-link
				>
					Solicitar demo
				</a>
			</div>
		</div>
	</div>
</header>

<style>@import './Nav.css';</style>

<script>
	const nav = document.querySelector('[data-nav]') as HTMLElement | null;
	const btn = document.querySelector('[data-menu-btn]') as HTMLButtonElement | null;
	const menu = document.querySelector('[data-menu]') as HTMLElement | null;

	if (nav) {
		const solid = () => {
			// The panel keys off this too, to avoid double-painting its ground.
			nav.toggleAttribute('data-solid', window.scrollY > 80);
		};
		solid();
		window.addEventListener('scroll', solid, { passive: true });
	}

	if (btn && menu) {
		const set = (open: boolean) => {
			menu.toggleAttribute('data-open', open);
			btn.setAttribute('aria-expanded', String(open));
			btn.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
		};

		btn.addEventListener('click', () => set(!menu.hasAttribute('data-open')));
		menu.querySelectorAll('[data-menu-link]').forEach((l) => l.addEventListener('click', () => set(false)));
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && menu.hasAttribute('data-open')) {
				set(false);
				btn.focus();
			}
		});
	}
</script>

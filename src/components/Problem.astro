---
import { Icon } from 'astro-icon/components';

const pains = [
	{
		icon: 'lucide:message-circle',
		title: 'El reporte vive en WhatsApp',
		body: 'Fotos sueltas en un chat, sin folio y sin firma. Cuando el cliente reclama en enero, nadie encuentra qué se hizo en agosto.',
	},
	{
		icon: 'lucide:package-search',
		title: 'Nadie sabe qué material salió',
		body: 'El refrigerante se cargó a la camioneta y ahí se perdió el rastro. El inventario cuadra una vez al año, con suerte.',
	},
	{
		icon: 'lucide:phone-off',
		title: 'La cotización se aprobó por teléfono',
		body: 'Sin documento, sin fecha, sin precio congelado. Y al facturar, el cliente recuerda otro número.',
	},
];
---

<section class="shell py-16 sm:py-24">
	<p class="label" data-reveal-p>El problema</p>
	<h2 class="measure-head mt-3 text-h1 font-semibold tracking-[-0.025em]" data-reveal-p>
		Tu operación funciona. Tu información, no.
	</h2>

	<div class="mt-10 grid gap-4 sm:mt-12 md:grid-cols-3">
		{
			pains.map((p) => (
				<article class="rounded-card bg-paper p-6 shadow-e2 sm:p-7" data-pain>
					<span class="tint grid size-11 place-items-center rounded-soft bg-brand-50 text-brand-ink">
						<Icon name={p.icon} class="size-5" />
					</span>
					<h3 class="mt-5 text-h3 font-semibold tracking-tight">{p.title}</h3>
					<p class="mt-2.5 text-ink-muted">{p.body}</p>
				</article>
			))
		}
	</div>
</section>

<script>
	import { reveal, revealStagger } from '../scripts/motion';
	reveal('[data-reveal-p]');
	revealStagger('[data-pain]');
</script>

---
import type { ImageMetadata } from "astro";
import { MODULES } from "../data/modules";
import ArtSlot from "./ArtSlot.astro";

/**
 * Pregunta → respuesta, en tarjetas.
 *
 * Las capturas del producto salieron de aquí (owner 2026-09-10): los dolores
 * se ilustran, no se demuestran — la demostración con capturas reales vive en
 * los casos de uso, en la línea de tiempo y en /features, que es donde el
 * visitante ya quiere ver la app.
 *
 * ILUSTRACIONES PENDIENTES. Cada tarjeta tiene su hueco listo: en cuanto
 * exista el archivo, se importa arriba y se pone en `illustration`. El hueco lo
 * dibuja `ArtSlot`, que es el mismo que usa la línea de tiempo del roadmap.
 */
const pairs: {
  module: string;
  ask: string;
  title: string;
  answer: string;
  illustration?: ImageMetadata;
}[] = [
  {
    module: "reportes",
    ask: "¿Las fotos y los reportes se pierden en el chat?",
    title: "Todo en un mismo reporte",
    answer:
      "Tus técnicos solo tienen que llenar el reporte con la firma del cliente y tu cliente recibe un PDF con el reporte. Nadie tiene que traspasarlo al llegar a la oficina ni acordarse de mandarlo.",
  },
  {
    module: "cotizaciones",
    ask: "¿Olvidaste la cotización que pidieron hace meses?",
    title: "Cotiza y entrega de inmediato",
    answer:
      "Envía la cotización inmediatamente después de crearla en el sistema: el cliente la aprueba o la rechaza ahí mismo y el precio queda fijo desde ese momento. Siempre hay constancia de quién aprobó y cuándo.",
  },
  {
    module: "campo",
    ask: "¿Tus técnicos no pueden abrir reportes si no hay señal?",
    title: "La app funciona sin internet",
    answer:
      "En sótanos, azoteas y naves industriales la app responde igual. El técnico captura ahí mismo y la información sube sola en cuanto recupera la red. Nadie tiene que volver a escribirla en la oficina.",
  },
  {
    module: "contratos",
    ask: "¿Las pólizas se vencen sin que nadie lo note?",
    title: "El sistema te recuerda",
    answer:
      "Las pólizas por vencer, los seguimientos pendientes y la agenda de la semana aparecen desde que entras. Lo que hoy recuerdas tú, mañana lo recuerda el sistema.",
  },
];

const byId = new Map(MODULES.map((m) => [m.id, m]));
const cards = pairs.map((p) => {
  const mod = byId.get(p.module);
  // Falla el build en vez de renderizar media tarjeta vacía.
  if (!mod) throw new Error(`Pains: no existe el módulo "${p.module}"`);
  return { ...p, mod };
});
---

<section id="dolores" class="pains">
  <div class="shell">
    <h2 class="section-title measure-head" data-reveal-p>
      Olvídate del papel y el lápiz.
    </h2>

    <ul class="cards grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-4">
      {
        cards.map((c) => (
          <li class="min-w-0 flex flex-col justify-between items-start px-6 py-4 gap-3 card" data-card>
            <p class="card-ask h-6">{c.ask}</p>
            <h3 class="card-title h-16">{c.title}</h3>
            <p class="card-body">{c.answer}</p>

            <ArtSlot illustration={c.illustration} class="w-full aspect-video" />

            <a class="card-link" href={`/features#${c.mod.id}`}>
              {c.mod.name}
              <span aria-hidden="true">&rarr;</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>@import './Pains.css';</style>

<script>
  import { reveal, revealStagger } from "../scripts/motion";
  reveal("[data-reveal-p]");
  revealStagger("[data-card]", { each: 0.08 });
</script>

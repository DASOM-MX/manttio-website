---
import { Icon } from 'astro-icon/components';

/**
 * Pregunta → respuesta. Las respuestas sin `soon` son cosas que el producto ya
 * hace hoy (ver `shipped: true` en `../data/modules.ts`). `soon: true` marca la
 * fila con el mismo chip "Próximamente" que usa el riel de módulos, para no
 * prometer en presente lo que todavía no está.
 */
const pairs = [
	{
		icon: 'lucide:send',
		ask: '¿Las fotos y los reportes se pierden en el chat?',
		title: 'Se envían en automático',
		answer:
			'El técnico cierra el reporte con la firma del cliente y el PDF sale al correo con tu logotipo. Nadie tiene que armarlo en la noche ni acordarse de mandarlo.',
	},
	{
		icon: 'lucide:notebook-pen',
		ask: '¿No recuerdas tu última conversación con un cliente?',
		title: 'Está registrada, con fecha',
		answer:
			'Cada llamada, cada visita y cada acuerdo quedan anotados con su fecha y con quién los atendió. Abres al cliente y ves todo lo que ha pasado, aunque haya sido hace ocho meses.',
	},
	{
		icon: 'lucide:file-check',
		ask: '¿Cotizaste por teléfono y ahora nadie recuerda el precio?',
		title: 'Queda por escrito y aprobada',
		answer:
			'Envías la cotización por un enlace, el cliente la aprueba o la rechaza ahí mismo y el precio queda fijo desde ese momento. Siempre hay constancia de quién aprobó y cuándo.',
	},
	{
		icon: 'lucide:wifi-off',
		ask: '¿Tus técnicos trabajan donde no hay señal?',
		title: 'La app funciona sin internet',
		answer:
			'En sótanos, azoteas y naves industriales la app responde igual. El técnico captura ahí mismo y la información sube sola en cuanto recupera la red. Nadie tiene que volver a escribirla en la oficina.',
	},
	{
		icon: 'lucide:bell-ring',
		ask: '¿Las pólizas se vencen sin que nadie lo note?',
		title: 'El sistema avisa con tiempo',
		answer:
			'Las pólizas por vencer, los seguimientos pendientes y la agenda de la semana aparecen desde que entras. Lo que hoy recuerdas tú, mañana lo recuerda el sistema.',
	},
	{
		icon: 'lucide:globe',
		ask: '¿Tus clientes te buscan en internet y no te encuentran?',
		title: 'Tu sitio web va incluido',
		answer:
			'Una página con tu nombre, tus colores y tu logotipo, publicada desde el mismo sistema y actualizada por ti sin depender de nadie. Es exactamente la página que estás leyendo.',
	},
	{
		icon: 'lucide:package',
		soon: true,
		ask: '¿Sabes qué material trae cada camioneta?',
		title: 'El inventario se actualiza solo',
		answer:
			'Cuánto hay en bodega y cuánto trae cada técnico, con el material descontado desde el mismo reporte donde se usó. Cada movimiento queda registrado y ninguno se edita después.',
	},
];
---

<section id="dolores" class="shell py-16 sm:py-24">
	<p class="label" data-reveal-p>¿Te suena?</p>
	<h2 class="measure-head mt-3 text-h1 font-semibold tracking-[-0.025em]" data-reveal-p>
		Que nada dependa de que alguien se acuerde.
	</h2>
	<p class="measure mt-5 text-lead text-ink-muted" data-reveal-p>
		Lo difícil no es el trabajo en sitio; eso tu equipo ya lo domina. Lo difícil es que la evidencia
		llegue completa, que el cliente reciba su reporte a tiempo y que en diciembre puedas demostrar
		exactamente qué se hizo en marzo. De eso nos encargamos nosotros.
	</p>

	<div class="mt-10 overflow-hidden rounded-card bg-paper shadow-e2 sm:mt-12">
		<ul class="divide-y divide-hair">
			{
				pairs.map((p, i) => (
					<li class="qa px-6 py-7 sm:px-8 sm:py-8" data-pair>
						<p class="text-lead font-medium tracking-tight text-balance">{p.ask}</p>

						<details
							class="ans mt-6 border-t border-hair-soft pt-6 lg:mt-0 lg:border-t-0 lg:border-l lg:border-hair lg:pt-0 lg:pl-8"
							open={i === 0}
						>
							<summary class="flex cursor-pointer list-none items-center gap-4">
								<span class="tint grid size-10 shrink-0 place-items-center rounded-soft bg-brand-50 text-brand-ink">
									<Icon name={p.icon} class="size-5" />
								</span>
								<h3 class="tint text-lead font-semibold tracking-tight text-brand-ink xl:text-h3">
									{p.title}{' '}
									{p.soon && <span class="soon align-middle">Próximamente</span>}
								</h3>
								<span class="chev ml-auto shrink-0 text-ink-faint" aria-hidden="true">
									<Icon name="lucide:chevron-down" class="size-5" />
								</span>
							</summary>
							<p class="ans-body mt-3 text-ink-muted">{p.answer}</p>
						</details>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	/* Layout lives here rather than in utilities: an Astro scoped rule is
	   unlayered, so it would beat anything from the utilities layer. Below the
	   breakpoint the row is plain flow — pregunta arriba, respuesta abajo.
	   The split waits for 1024 px: at 768 the respuesta column comes out as
	   narrow as a phone's, which wraps every headline to three lines. */
	@media (min-width: 1024px) {
		.qa {
			display: grid;
			grid-template-columns: 0.85fr 1.15fr;
			gap: 2rem;
			align-items: stretch;
		}
		/* The row stretches so the divider spans it; the pregunta centers
		   itself against a taller respuesta rather than floating at the top. */
		.qa > p:first-child {
			display: flex;
			align-items: center;
		}
	}

	/* The respuesta collapses; the pregunta and the headline always show, so the
	   list stays scannable at seven rows. Native <details>, so it works with the
	   keyboard and without JS. */
	.ans > summary::-webkit-details-marker {
		display: none;
	}
	/* At the two-column width the body aligns under the title rather than under
	   the icon tile (2.5rem icon + 1rem gap). On a phone the column is only
	   ~264 px wide, so that indent costs more than the alignment is worth. */
	@media (min-width: 1024px) {
		.ans-body {
			padding-left: 3.5rem;
		}
	}
	.chev {
		display: grid;
		place-items: center;
		transition: transform 240ms var(--ease-out);
	}
	.ans[open] .chev {
		transform: rotate(180deg);
	}

	/* Same chip as the module rail, so "Próximamente" reads the same twice. */
	.soon {
		display: inline-block;
		margin-left: 0.15rem;
		border-radius: 999px;
		background: var(--color-mist);
		padding: 0.15rem 0.5rem;
		font-size: 0.6875rem;
		font-weight: 500;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-ink-faint);
		white-space: nowrap;
	}
</style>

<script>
	import { reveal, revealStagger } from '../scripts/motion';
	reveal('[data-reveal-p]');
	revealStagger('[data-pair]');
</script>

---
import { Image } from "astro:assets";

import { MODULES } from "../data/modules";
import { USE_CASES } from "../data/use-cases";
import AppShot from "./AppShot.astro";

/**
 * Casos de uso — cinco sectores, un panel a la vez.
 *
 * Es un tablist real (no un carrusel automático y no está atado al scroll):
 * el visitante elige su sector y el panel cambia. Sin JS los cinco paneles se
 * apilan y se leen todos, que es la razón de que cada uno sea un `[hidden]`
 * quitado por script y no un panel oculto por CSS.
 */
const byId = new Map(MODULES.map((m) => [m.id, m]));
const cases = USE_CASES.map((c) => {
  const shot = byId.get(c.shot);
  if (!shot) throw new Error(`UseCases: no existe el módulo "${c.shot}"`);
  return {
    ...c,
    shotModule: shot,
    links: c.modules.map((id) => {
      const m = byId.get(id);
      if (!m) throw new Error(`UseCases: no existe el módulo "${id}"`);
      return m;
    }),
  };
});
---

<section id="casos" class="cases">
  <div class="shell">
    <h2 class="section-title measure-head mt-3" data-reveal-c>
      Un mismo sistema, distintas formas de trabajar.
    </h2>

    <div class="cases-body" data-cases>
      <div class="tabs" role="tablist" aria-label="Sectores">
        {
          cases.map((c, i) => (
            <button
              type="button"
              role="tab"
              id={`uc-tab-${c.id}`}
              aria-controls={`uc-panel-${c.id}`}
              aria-selected={i === 0 ? "true" : "false"}
              tabindex={i === 0 ? 0 : -1}
              class="tab"
              data-tab
            >
              {c.label}
            </button>
          ))
        }
      </div>

      <div class="panels">
        {
          cases.map((c, i) => (
            <div
              role="tabpanel"
              id={`uc-panel-${c.id}`}
              aria-labelledby={`uc-tab-${c.id}`}
              tabindex="0"
              class="panel"
              data-panel
              data-active={i === 0 ? "true" : undefined}
            >
              <div class="panel-copy">
                <h3 class="panel-title">{c.headline}</h3>
                <p class="measure mt-4 text-ink-muted">{c.body}</p>
                <ul class="chips">
                  {c.links.map((m) => (
                    <li>
                      <a href={`/features#${m.id}`} class="chip">
                        {m.name}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
              <div class="panel-shot" data-shot>
                {c.art ? (
                  <Image
                    src={c.art}
                    alt=""
                    widths={[560, 860, 1200]}
                    sizes="(min-width: 1024px) 47vw, 80vw"
                    loading="lazy"
                    class="panel-art"
                  />
                ) : (
                  <AppShot module={c.shotModule} />
                )}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>@import './UseCases.css';</style>

<script>
  import { reveal } from "../scripts/motion";

  reveal("[data-reveal-c]");

  // El esqueleto se quita en cuanto la imagen está lista. Hace falta de verdad:
  // `loading="lazy"` dentro de un panel en `display:none` no dispara, así que la
  // descarga empieza al cambiar de pestaña y el hueco existe hasta que termina.
  // También se quita en `error`, porque un esqueleto latiendo para siempre miente
  // más que un hueco vacío.
  document.querySelectorAll<HTMLImageElement>("[data-shot] img").forEach((img) => {
    const done = () => img.closest("[data-shot]")?.setAttribute("data-loaded", "");
    if (img.complete && img.naturalWidth > 0) done();
    else {
      img.addEventListener("load", done, { once: true });
      img.addEventListener("error", done, { once: true });
    }
  });

  const root = document.querySelector<HTMLElement>("[data-cases]");
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-tab]"));
    const panels = Array.from(root.querySelectorAll<HTMLElement>("[data-panel]"));

    // Only now that a script is running does hiding panels become safe.
    root.dataset.ready = "true";

    const select = (next: number, focus = true) => {
      tabs.forEach((t, i) => {
        const on = i === next;
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
        if (on) panels[i].setAttribute("data-active", "true");
        else panels[i].removeAttribute("data-active");
      });
      if (focus) tabs[next].focus();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => select(i, false));
      tab.addEventListener("keydown", (e) => {
        const keys: Record<string, number> = {
          ArrowRight: i + 1,
          ArrowDown: i + 1,
          ArrowLeft: i - 1,
          ArrowUp: i - 1,
          Home: 0,
          End: tabs.length - 1,
        };
        const target = keys[e.key];
        if (target === undefined) return;
        e.preventDefault();
        select((target + tabs.length) % tabs.length);
      });
    });
  }
</script>

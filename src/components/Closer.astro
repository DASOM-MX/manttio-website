---
import { Icon } from "astro-icon/components";
import { CONTACT } from "../consts";

/**
 * El cierre. Solo el CTA — el pie de página salió a `Footer.astro` porque el
 * orden de la página pone las preguntas DESPUÉS de la petición, y un pie
 * pegado al CTA habría dejado el FAQ colgando debajo del footer.
 */
const wa = CONTACT.whatsapp.replace(/[^0-9]/g, "");
---

<section id="contacto" class="closer">
  <div class="shell closer-inner">
    <h2 class="closer-title" data-reveal-x>
      Te mostramos el sistema con tus propios servicios.
    </h2>
    <p class="measure mt-5 text-lead closer-sub">
      Solicita tu demo hoy mismo, sin compromiso, totalmente gratis y
      totalmente personalizado a las necesidades de tu negocio.
    </p>

    <div class="closer-ctas">
      <a href={`https://wa.me/${wa}`} class="closer-primary">
        <Icon name="lucide:message-circle" class="size-4" />
        Escríbenos por WhatsApp
      </a>
      <a href={`mailto:${CONTACT.email}`} class="closer-ghost">
        <Icon name="lucide:mail" class="size-4" />
        {CONTACT.email}
      </a>
    </div>
    <!-- TODO(plan CP-4): formulario /demo + captura UTM cuando se decida el destino del lead. -->
  </div>
</section>

<style>@import './Closer.css';</style>

<script>
  import { reveal } from "../scripts/motion";
  reveal("[data-reveal-x]");
</script>

---
/**
 * A module's visual: the real app where we have a capture, the HTML faux-UI
 * where we don't. Captures come from the screenshot harnesses in the
 * whitelabeled repo and only exist for shipped modules — so the fallback and
 * the "Próximamente" chip always agree with each other.
 */
import { Image } from 'astro:assets';
import type { Module } from '../data/modules';
import FauxFrame from './FauxFrame.astro';

interface Props {
	module: Module;
	class?: string;
	loading?: 'eager' | 'lazy';
	/**
	 * `list` is the module's own screen — what the showcase rail wants. `detail`
	 * is one record open, which is what the "Dolores" panels argue. Falls back to
	 * the list capture where no detail one exists (the CMS editor already is one).
	 */
	variant?: 'list' | 'detail';
}

const { module, class: className = '', loading = 'lazy', variant = 'list' } = Astro.props;
const shot = (variant === 'detail' && module.shotDetail) || module.shot;
const alt =
	variant === 'detail' && module.shotDetail
		? `${module.name}: un registro abierto en Manttio`
		: `${module.name} en Manttio`;
---

{
	shot ? (
		module.shotKind === 'mobile' ? (
			<div class={`mx-auto w-full max-w-shot ${className}`}>
				<Image
					src={shot}
					alt={alt}
					widths={[268, 536]}
					sizes="268px"
					loading={loading}
					class="w-full rounded-phone shadow-e3"
				/>
			</div>
		) : (
			<Image
				src={shot}
				alt={alt}
				widths={[720, 1080, 1440, 1920, 2400]}
				sizes="(min-width: 1024px) 92vw, 100vw"
				loading={loading}
				class={`w-full rounded-frame shadow-e3 ${className}`}
			/>
		)
	) : (
		<FauxFrame module={module} class={className} />
	)
}
